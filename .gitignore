# PROMPTECTOMY uses Rust, Python, and bun/Next.js. Local state and generated
# candidates stay outside version control.

# --- Secrets (never commit; commit .env.example instead) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
.secrets/
credentials.json
service-account*.json

